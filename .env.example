# Copy to .env and fill in. The server reads this; the key never reaches the browser.
#
# Works with any OpenAI-compatible API: hosted OpenAI, a deployed gateway
# (Azure OpenAI, OpenRouter, etc.), or a local model server.
OPENAI_API_KEY=sk-...

# Optional overrides
PORT=8787
OPENAI_MODEL=gpt-4o-mini

# Point at a different OpenAI-compatible endpoint. Leave unset to use the
# hosted OpenAI API. Examples for local model servers:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
