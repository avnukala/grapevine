# Copy to .env to change a setting. The back end and Vite read these.

# The OpenAI-compatible server of the local models. LM Studio listens here by default.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=gemma-4-e4b
# A larger model for the end-of-session pass and the merge. Defaults to LLM_MODEL.
# SUMMARY_MODEL=

# The model directory, to record a fingerprint of the model files on each model call.
# LLM_MODEL_PATH=~/.lmstudio/models/lmstudio-community/gemma-4-E4B-it-MLX-4bit

# The API port. Vite proxies /api and /ws to it.
PORT=8790

# GRAPEVINE_DB=data/grapevine.db
